# Copy to .env.  The shared server needs nothing here.
# To receive problem reports as well, set both and start with:  docker compose --profile reports up -d --build
REPORTS_DOMAIN=
REPORT_TOKEN=
# Optional: a different secret for the admin console (https://<REPORTS_DOMAIN>/admin, paste it into the form there).
# Leave it empty to keep the console switched off. The app never needs it.
ADMIN_TOKEN=

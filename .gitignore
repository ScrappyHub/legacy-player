# --- Legacy Player .gitignore (grouped; nothing here is source) ---

# Build output and release packaging (the release workflow builds these; they are never committed)
build/
dist/
out/
*.spec
build.log
smoke/
smoke-data/
_to_delete/

# Logs and temp
*.log
tmp/
temp/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.bak_pre_fix
.venv/
venv/
env/

# A player's data folder, if one is ever created inside the checkout (settings, saves, covers, damaged-file copies)
.legacy-player/
user_data*.json
user_data*.corrupt

# Local probe exports / evidence
tools/memory_probe/exports/
tools/memory_probe/_out/
tools/memory_probe/_scratch/

# Replay / captures / generated artifacts
replays/
captures/
artifacts/

# Emulator-local or user-local directories
local/
user/

# Node / Rust / Go leftovers from other tooling
node_modules/
target/
bin/

# Local env and OS / editor
.env
.env.local
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/worktrees/
